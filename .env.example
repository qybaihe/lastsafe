# Public deployments should remain replay or read-only unless protected by an execution token.
LASTSAFE_MODE=replay
LASTSAFE_DATABASE_PATH=data/lastsafe.db
LASTSAFE_EXECUTION_ENABLED=false
LASTSAFE_EXECUTION_TOKEN=

# Alpaca paper account. Never commit these values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=indicative
ALPACA_CLI_PATH=alpaca

# Any OpenAI-compatible endpoint works. Featherless credits are provided by the event.
LLM_API_KEY=
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_MODEL=zai-org/GLM-5.2
